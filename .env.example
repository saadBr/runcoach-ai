# Application
RUNCOACH_ENVIRONMENT=development
RUNCOACH_LOG_LEVEL=INFO
RUNCOACH_API_HOST=0.0.0.0
RUNCOACH_API_PORT=8000

# API endpoint used when the Streamlit dashboard runs directly on the host
RUNCOACH_API_URL=http://localhost:8000

# Stable private athlete UUID; generate a different value for each installation
RUNCOACH_ATHLETE_ID=

# Database URL used when running the API directly from the Windows host
RUNCOACH_DATABASE_URL=postgresql+psycopg://runcoach:runcoach-local@localhost:5432/runcoach

# Local Docker Compose database
POSTGRES_DB=runcoach
POSTGRES_USER=runcoach
POSTGRES_PASSWORD=runcoach-local

# Private activity-file storage; this directory is ignored by Git
RUNCOACH_PRIVATE_DATA_DIR=./data/private

# LLM support remains disabled unless explicitly configured
RUNCOACH_LLM_PROVIDER=disabled
RUNCOACH_OPENAI_MODEL=
RUNCOACH_OPENAI_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
